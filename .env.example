# Copy to .env and fill in. Never commit the real .env.

# --- Postgres staging ---
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# --- BC SaaS / Azure AD (OAuth2 client credentials) ---
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
BC_CLIENT_SECRET=replace-me
BC_ENVIRONMENT=sandbox
BC_COMPANY_ID=00000000-0000-0000-0000-000000000000
# Base URL for the BC API (v2.0 standard or your custom API namespace)
BC_API_BASE_URL=https://api.businesscentral.dynamics.com/v2.0
# Optional: override the OAuth2 token endpoint (e.g. to point at a local mock
# for end-to-end runs / benchmarking). Defaults to Azure AD for the tenant.
# BC_TOKEN_URL=http://localhost:8080/token

# --- Orchestrator tuning (start here, then measure) ---
IMPORT_CHUNK_SIZE=200
MAX_CONCURRENT_CHUNKS=4
# Invoices imported into BC concurrently. Raise until you see 429s, then back off.
IMPORT_CONCURRENCY=8
# If true, unmapped parties fail; if false, the source party id is passed through
# to BC unchanged (fine when sources already use BC customer/vendor numbers).
REQUIRE_PARTY_MAPPING=false
# Same, for line-item codes (source item code -> BC item number).
REQUIRE_ITEM_MAPPING=false
# Validate documents against synced BC reference data (customers/vendors/items)
# before import, so unknowns are caught externally. Populate ref_entity first
# with:  cargo run -p orchestrator -- sync-refs
# then set this to true.
VALIDATE_REFERENCES=false

# --- Logging ---
RUST_LOG=info
